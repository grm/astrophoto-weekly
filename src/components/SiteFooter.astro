---
import { pathWithBase } from '../lib/site';
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <div class="footer-brand">✦ AstroPhoto Weekly</div>
      <p>Une veille francophone indépendante sur l’astrophoto, publiée chaque semaine.</p>
    </div>
    <div class="footer-links">
      <a href={pathWithBase('/archives/')}>Archives</a>
      <a href={pathWithBase('/a-propos/')}>Méthode éditoriale</a>
      <a href={pathWithBase('/rss.xml')}>Flux RSS</a>
    </div>
  </div>
  <div class="shell footer-note">Étoiles rondes non garanties. Sources vérifiées, câbles USB sous surveillance.</div>
</footer>
