---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, pathWithBase } from '../../lib/site';

export async function getStaticPaths() {
  const issues = await getCollection('issues');
  return issues.map((issue) => ({ params: { slug: issue.id }, props: { issue } }));
}

interface Props { issue: CollectionEntry<'issues'>; }
const { issue } = Astro.props;
const { Content } = await render(issue);
const number = String(issue.data.number).padStart(3, '0');
---
<BaseLayout title={issue.data.title} description={issue.data.description} article>
  <article class="issue shell">
    <header class="issue-hero">
      <a class="back-link" href={pathWithBase('/archives/')}>← Archives</a>
      <div class="issue-kicker">AstroPhoto Weekly <span>#{number}</span></div>
      <h1>{issue.data.title}</h1>
      <p class="issue-description">{issue.data.description}</p>
      <div class="issue-meta">
        <time datetime={issue.data.date.toISOString()}>{formatDate(issue.data.date)}</time>
        <span>Lecture éditoriale · sources liées dans l’article</span>
      </div>
    </header>
    <div class="prose issue-prose"><Content /></div>
    <footer class="issue-end">
      <span>✦</span>
      <p>Fin de transmission. Vous pouvez maintenant retourner vérifier votre RMS.</p>
      <a href={pathWithBase('/archives/')}>Voir toutes les éditions →</a>
    </footer>
  </article>
</BaseLayout>
